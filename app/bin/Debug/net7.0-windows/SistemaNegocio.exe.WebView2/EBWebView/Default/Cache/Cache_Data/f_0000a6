<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Módulo de Ventas</title>

    <link rel="stylesheet" href="../css/bootstrap-icons/bootstrap-icons.css">

    <link rel="stylesheet" href="../css/bootstrap.min.css">



    <link rel="stylesheet" href="../css/select2.min.css">

    <style>
      /* ================================
    TIPOGRAFÍA GLOBAL MEJORADA
================================ */
      body,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6,
      button,
      .form-control,
      .form-select,
      label {
        font-family: "Poppins", sans-serif !important;
        letter-spacing: 0.2px;
      }

      /* Títulos principales (Módulo de Ventas, Cierre modal) */
      h2,
      .modal-title {
        font-weight: 400;
        font-size: 1.65rem;
        color: #234c88;
        letter-spacing: 0.5px;
      }

      /* Subtítulos de secciones (Registrar venta, Ventas del día) */
      .titulo-seccion {
        font-weight: 600 !important;
        font-size: 1.15rem !important;
        color: #234c88 !important;
        border-bottom-width: 3px;
        letter-spacing: 0.4px;
      }

      /* Texto de descripción en modales */
      .modal-body,
      .modal-login-body,
      .modal-content p {
        font-weight: 500;
        color: #444;
        font-size: 0.95rem;
      }

      /* ================================
    NÚMEROS PREMIUM
================================ */
      .monto,
      #subtotalCarrito,
      #totalVendido,
      #totalGanancia,
      .cierre-valor,
      .ganancia,
      .total {
        font-family: "Poppins", sans-serif !important;
        font-weight: 700 !important;
        letter-spacing: 0.4px;
        font-size: 1.22rem !important;
        color: #1b3a6b !important;
      }

      /* Números positivos (ganancia) */
      .text-success,
      .ganancia {
        color: #0a9b39 !important;
        font-weight: 800 !important;
      }

      /* Números dentro de resumen de cierre */
      .cierre-valor {
        font-size: 1.45rem !important;
        font-weight: 800 !important;
      }

      /* Etiquetas de resumen ("Total vendido:") */
      .total-label {
        font-weight: 600;
        font-size: 0.98rem;
        color: #346ccf;
        letter-spacing: 0.3px;
      }

      /* ===========================================================
    DRUGSTORE UI — VENTAS PRO (Bootstrap Icons + Flat Soft UI)
=========================================================== */

      :root {
        --primary: #234c88;
        --primary-soft: #cfe2ff;
        --primary-light: #e7f1ff;
        --accent: #68a8ff;
        --success: #15b374;
        --danger: #e54848;
        --gray: #6c7a91;
        --white: #ffffff;
      }

      /* ======== GENERAL ======== */
      body {
        background: var(--primary-light);
        font-family: "Inter", sans-serif;
      }

      /* ======== HEADER ======== */
      .page-title {
        padding: 18px 26px;
        background: var(--primary-soft);
        border-radius: 18px;
        border-left: 6px solid var(--accent);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .page-title h2 {
        font-weight: 900;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
      }

      /* Bootstrap icon grande */
      .page-title h2 i {
        font-size: 30px;
        margin-right: 3px;
        color: var(--primary);
      }

      .page-title a {
        background: var(--primary);
        color: #fff !important;
        padding: 10px 28px;
        font-weight: 700;
        border-radius: 12px;
        transition: 0.25s;
      }
      .page-title a:hover {
        background: #132c57;
      }

      /* ======== CARD ======== */
      .card {
        border-radius: 18px !important;
        border: 1px solid #d4e4ff;
        background: var(--white);
      }

      /* Título card con icono Bootstrap */
      .titulo-seccion {
        font-weight: 800;
        font-size: 1.35rem;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
      }

      /* ícono de carta  */
      .titulo-seccion i {
        font-size: 28px;
        color: var(--primary);
      }

      /* ======== INPUTS ======== */
      .form-label {
        font-weight: 700;
        color: var(--primary);
        font-size: 14px;
      }

      .form-control,
      .form-select {
        height: 44px !important;
        border-radius: 10px !important;
        border: 1px solid #b5c8e4 !important;
        background: #fff;
        color: #28415d;
        font-size: 15px;
        transition: 0.2s;
      }
      .form-control:focus,
      .form-select:focus {
        border-color: var(--accent) !important;
        box-shadow: 0 0 0 3px rgba(104, 168, 255, 0.35) !important;
      }

      /* ======== SELECT2 ======== */
      .select2-container--default .select2-selection--single {
        height: 44px !important;
        display: flex !important;
        align-items: center !important;
        border-radius: 10px !important;
        border: 1px solid #b5c8e4 !important;
        padding-left: 10px !important;
        font-size: 15px;
      }
      .select2-selection__arrow {
        height: 44px !important;
      }

      /* ======== BOTONES ======== */
      .btn-success,
      #btnAgregarCarrito {
        background: var(--success) !important;
        border: none;
        border-radius: 10px !important;
        font-weight: 700;
        transition: 0.2s;
      }
      .btn-success:hover,
      #btnAgregarCarrito:hover {
        background: #0e7f3f !important;
      }

      #btnVaciarCarrito {
        border-radius: 10px !important;
        border: 2px solid var(--danger) !important;
        color: var(--danger) !important;
        font-weight: 700;
        transition: 0.2s;
      }
      #btnVaciarCarrito:hover {
        background: var(--danger) !important;
        color: #fff !important;
      }

      /* ======== TABLAS ======== */
      .table {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #cddfff;
        font-size: 0.95rem;
        background: white;
      }

      .table thead {
        background: var(--primary-soft) !important;
        color: var(--primary) !important;
        font-weight: 800 !important;
        font-size: 0.9rem;
      }

      .table tbody tr:hover {
        background: var(--primary-light) !important;
      }

      /* Totales */
      #subtotalCarrito,
      #totalVendido,
      #totalGanancia {
        font-size: 1.35rem;
        font-weight: 900;
        color: var(--primary);
      }

      /* ======== FILTRO FECHA ======== */
      #btnBuscarFecha,
      #btnHoy {
        border-radius: 10px !important;
        padding: 10px 20px;
        font-weight: 700;
      }
      #btnBuscarFecha {
        background: var(--primary) !important;
        color: #fff !important;
      }
      #btnBuscarFecha:hover {
        background: #132c57 !important;
      }
      #btnHoy {
        border: 2px solid var(--primary) !important;
        color: var(--primary) !important;
      }
      #btnHoy:hover {
        background: var(--primary) !important;
        color: #fff !important;
      }

      /* ======== BOTÓN FINAL CIERRE ======== */
      .btn-dark.rounded-pill {
        background: var(--primary) !important;
        border: none !important;
        border-radius: 14px !important;
        padding: 12px 32px;
        font-weight: 900;
      }
      .btn-dark.rounded-pill:hover {
        background: #132c57 !important;
      }

      /* ===========================================================
      CIERRE DE CAJA — REDISEÑO PRO (Flat Smooth UI)
=========================================================== */

      #modalCierreCaja .modal-content {
        border-radius: 22px !important;
        border: 2px solid #cddfff !important;
        padding: 25px 28px !important;
        background: #ffffff;
      }

      /* Título con icono */
      #modalCierreCaja .modal-title {
        font-size: 1.6rem;
        font-weight: 900;
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 10px;
      }
      #modalCierreCaja .modal-title i {
        font-size: 26px;
        color: var(--primary);
      }

      /* Fecha del cierre */
      .cierre-fecha {
        font-size: 0.9rem;
        color: var(--gray);
        margin-bottom: 15px;
        display: flex;
        gap: 6px;
        align-items: center;
      }
      .cierre-fecha i {
        color: var(--primary);
      }

      /* ====== CARDS DE CIERRE ====== */
      .cierre-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 22px;
      }
      @media (max-width: 550px) {
        .cierre-grid {
          grid-template-columns: 1fr;
        }
      }

      .cierre-card {
        background: #fdfefe;
        border: 1px solid #d4e4ff;
        border-radius: 16px;
        padding: 14px 16px;
        text-align: center;
        transition: 0.25s;
        cursor: default;
      }
      .cierre-card:hover {
        background: var(--primary-light);
      }

      /* Títulos + Iconos dentro de cards */
      .cierre-titulo {
        font-weight: 700;
        color: var(--primary);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
      }
      .cierre-titulo i {
        font-size: 18px;
        color: var(--primary);
      }

      /* Valores */
      .cierre-valor {
        font-size: 22px;
        font-weight: 900;
        color: #0b2549;
      }

      /* ====== RESUMEN FINAL ====== */
      .cierre-resumen {
        background: #ffffff;
        border-radius: 16px;
        padding: 18px;
        border: 1px solid #cddfff;
      }

      .cierre-resumen h5 {
        font-weight: 900;
        color: var(--primary);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .cierre-resumen h5 i {
        font-size: 22px;
      }

      .cierre-resumen .total {
        font-size: 15px;
        font-weight: 700;
        color: #333;
        display: flex;
        justify-content: space-between;
      }
      .cierre-resumen .ganancia {
        font-size: 16px;
        font-weight: 900;
        color: var(--success);
        display: flex;
        justify-content: space-between;
      }

      /* ====== BOTÓN FINAL ======= */
      #modalCierreCaja .btn-danger {
        background: var(--danger) !important;
        border: none !important;
        font-weight: 800;
        padding: 10px 28px;
        border-radius: 12px;
        transition: 0.2s;
      }
      #modalCierreCaja .btn-danger:hover {
        background: #c82121 !important;
      }
      #modalOpcionesCaja .modal-content {
        border-radius: 22px;
        border: 1.8px solid #1168ff;
        padding: 30px 35px !important;
        background: #ffffff;
      }

      #modalOpcionesCaja h4 {
        font-size: 1.65rem;
        font-weight: 800;
        color: #204a88;
        text-shadow: 0px 1px 3px rgba(32, 74, 136, 0.25);
        letter-spacing: -0.3px;
        margin-bottom: 6px;
      }

      /* Grid limpio */
      #modalOpcionesCaja .d-grid {
        grid-template-columns: 1fr;
      }

      /* Tarjetas-botón */
      .btn-caja-option {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 18px !important;
        background: #f8fbff;
        border: 1px solid #d9e7ff !important;
        font-weight: 700;
        font-size: 16px;
        color: #113c6b;
        transition: 0.22s ease;
        box-shadow: 2px 3px 8px rgba(0, 0, 0, 0.08),
          -2px -2px 6px rgba(255, 255, 255, 0.9);
      }

      /* Ícono elegante */
      .btn-caja-option i {
        font-size: 22px;
        color: var(--primary);
        padding: 10px;
        border-radius: 12px;
        background: #eef4ff;
        transition: 0.25s;
      }

      /* Hover */
      .btn-caja-option:hover {
        transform: translateY(-3px);
        box-shadow: 4px 6px 14px rgba(0, 0, 0, 0.12),
          -3px -3px 8px rgba(255, 255, 255, 0.9);
        background: #ffffff;
      }

      /* Hover en icono */
      .btn-caja-option:hover i {
        background: var(--primary-light);
        color: #003f91;
      }

      /* Activo visual */
      .btn-caja-option:active {
        transform: scale(0.98);
      }
    </style>
  </head>

  <body>
    <input
      type="text"
      id="codigoScanner"
      style="opacity: 0; position: absolute; pointer-events: none"
    />

    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cart-check"></i> Módulo de Ventas</h2>
        <a href="/index.html" class="btn btn-secondary rounded-pill px-4">
          <i class="bi bi-arrow-left-circle"></i> Volver
        </a>
      </div>

      <!-- ===============================
        REGISTRAR VENTA
  =============================== -->
      <div class="card p-4 mb-4 shadow-sm">
        <h4 class="titulo-seccion">Registrar venta</h4>

        <form id="formVentaNormal" class="row g-2 align-items-end">
          <div class="col-md-3">
            <label class="form-label">Producto</label>
            <select id="productoSelect" class="form-select"></select>
          </div>

          <div class="col-md-2">
            <label class="form-label">Stock disponible</label>
            <input
              type="text"
              id="stockDisponible"
              class="form-control"
              readonly
            />
          </div>

          <div class="col-md-2">
            <label class="form-label">Cantidad</label>
            <input type="number" id="cantidad" class="form-control" min="1" />
          </div>

          <div class="col-md-2">
            <label class="form-label">Forma de pago</label>
            <select id="formaPago" class="form-select">
              <option>Efectivo</option>
              <option>Transferencia</option>
              <option>Tarjeta Débito</option>
              <option>Tarjeta Crédito</option>
            </select>
          </div>

          <div class="col-md-2">
            <label class="form-label">Total ($)</label>
            <input type="text" id="total" class="form-control" readonly />
          </div>

          <div class="col-md-1 text-end">
            <button class="btn btn-success rounded-pill w-100">
              <i class="bi bi-check-circle"></i>
            </button>
          </div>
        </form>

        <!-- Carrito -->
        <div class="mt-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="text-secondary mb-0">Carrito</h5>

            <div class="d-flex gap-2">
              <button
                class="btn btn-primary rounded-pill"
                id="btnAgregarCarrito"
              >
                <i class="bi bi-plus-circle"></i> Agregar al carrito
              </button>

              <button
                class="btn btn-outline-danger rounded-pill"
                id="btnVaciarCarrito"
              >
                <i class="bi bi-trash"></i> Vaciar carrito
              </button>
            </div>
          </div>

          <div class="table-responsive">
            <table
              class="table table-bordered table-striped text-center align-middle"
            >
              <thead class="table-light">
                <tr>
                  <th>Producto</th>
                  <th>Cantidad</th>
                  <th>Precio unitario</th>
                  <th>Total</th>
                  <th>Accion</th>
                  <th>Accion</th>
                </tr>
              </thead>
              <tbody id="tablaCarrito"></tbody>
            </table>
          </div>

          <h6 class="text-end mt-2 total-label">
            Subtotal carrito:
            <span id="subtotalCarrito" class="monto">$0.00</span>
          </h6>
        </div>
      </div>

      <!-- ===============================
        VENTAS DEL DÍA
  =============================== -->
      <div class="card p-3 mb-4 shadow-sm">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <label class="fw-bold text-secondary mb-0">Ver ventas del día:</label>
          <input
            type="date"
            id="fechaFiltro"
            class="form-control"
            style="width: 200px"
          />
          <button id="btnBuscarFecha" class="btn btn-primary rounded-pill">
            <i class="bi bi-search"></i> Buscar
          </button>
          <button id="btnHoy" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-calendar-day"></i> Hoy
          </button>
        </div>
      </div>

      <div class="card p-4 shadow-sm">
        <h4 class="titulo-seccion">Ventas del día</h4>

        <div class="table-responsive">
          <table
            class="table table-bordered table-striped text-center align-middle"
          >
            <thead class="table-success">
              <tr>
                <th>Fecha</th>
                <th>Producto</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Forma de pago</th>
                <th>Total</th>
                <th>Ganancia</th>
              </tr>
            </thead>
            <tbody id="tablaVentas"></tbody>
          </table>
        </div>

        <div class="text-end mt-3">
          <p class="total-label">
            Total vendido:
            <span id="totalVendido" class="monto">$0.00</span>
          </p>

          <p class="total-label">
            Ganancia total:
            <span id="totalGanancia" class="monto text-success">$0.00</span>
          </p>
        </div>
      </div>

      <div class="text-end my-4">
        <button
          class="btn btn-dark rounded-pill px-4"
          data-bs-toggle="modal"
          data-bs-target="#modalPasswordCaja"
        >
          🔒 Cierre de caja
        </button>
      </div>
    </div>
    <!-- cierre container -->

    <!-- ============================================================
        🔒 MODAL PASSWORD (igual que SUELTOS)
============================================================ -->
    <!-- 🔒 MODAL: Contraseña -->
    <div class="modal fade" id="modalPasswordCaja" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Ingrese contraseña</h5>

            <button class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input
              type="password"
              id="passCaja"
              class="form-control"
              placeholder="Contraseña..."
            />
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" data-bs-dismiss="modal">
              Cancelar
            </button>
            <button id="btnValidarCaja" class="btn btn-primary">
              Ingresar
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
        🔵 MODAL OPCIONES (general – sueltos – cigarros)
============================================================ -->
    <!-- 📦 MODAL: Opciones de tipo de cierre -->
    <div class="modal fade" id="modalOpcionesCaja" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4 text-center">
          <h4 class="fw-bold mb-3">Cierre de Caja</h4>
          <p
            class="total-label mb-4"
            style="color: #234c88 !important; font-weight: 500"
          >
            Seleccioná el tipo de venta que querés ver
          </p>

          <div class="d-grid gap-3">
            <button class="btn btn-caja-option btn-general" id="btnCajaGeneral">
              <i class="bi bi-box-seam"></i>Productos Generales
            </button>
            <button class="btn btn-caja-option btn-suelto" id="btnCajaSueltos">
              <i class="bi bi-shop"></i>Sueltos
            </button>
            <button
              class="btn btn-caja-option btn-cigarro"
              id="btnCajaCigarros"
            >
              <i class="bi bi-grip-vertical"></i>Cigarros
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
        📊 MODAL FINAL — IGUAL A SUELTOS
============================================================ -->
    <!-- 📊 MODAL: Cierre de Caja FINAL (idéntico a sueltos) -->
    <div class="modal fade" id="modalCierreCaja" tabindex="-1">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-3">
          <div class="modal-header">
            <h4 class="modal-title fw-bold">Cierre de Caja</h4>
            <button class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body" id="contenidoCierreCaja">
            <!-- El JS llenará este contenido -->
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
        SCANNER
============================================================ -->
    <div class="modal fade" id="modalPrecioScanner" tabindex="-1">
      <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content text-center p-3">
          <h5 id="precioScannerNombre" class="fw-bold"></h5>
          <p id="precioScannerValor" class="fs-2 text-primary fw-bold"></p>
          <button class="btn btn-secondary w-100" data-bs-dismiss="modal">
            Cerrar
          </button>
        </div>
      </div>
    </div>

    <!-- Modal para seleccionar el producto -->
    <div
      id="modalElegirProducto"
      class="modal fade"
      tabindex="-1"
      aria-labelledby="modalElegirProductoLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
          <h5 class="fw-bold text-center mb-3">Elegí el producto a vender</h5>
          <div id="listaOpcionesProducto" class="d-grid gap-2">
            <!-- Aquí agregarás dinámicamente los botones con solo el texto "Elegir" -->
          </div>
        </div>
      </div>
    </div>
<script src="../js/jquery.min.js"></script>
<script src="../js/select2.min.js"></script>


    <script src="../js/bootstrap.bundle.min.js"></script>

    <script src="../js/ventas.js"></script>
    <script>

      document.addEventListener("shown.bs.modal", () => {
        document.documentElement.classList.add("modal-open");
        document.body.classList.add("modal-open");
      });

      document.addEventListener("hidden.bs.modal", () => {
        document.documentElement.classList.remove("modal-open");
        document.body.classList.remove("modal-open");
      });

      // Previene lag del modal al abrir/cerrar
      document.addEventListener("shown.bs.modal", (e) => {
        document.body.style.overflowY = "hidden";
      });
      document.addEventListener("hidden.bs.modal", (e) => {
        document.body.style.overflowY = "auto";
      });
    </script>
  </body>
</html>
